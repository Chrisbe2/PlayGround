# Copy to config.env and edit. Never commit or share your real token.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Public Binance spot market data. Change only if required for your region.
BINANCE_BASE_URL=https://api.binance.com

SIGNAL_INTERVAL=5m
KLINE_LIMIT=180
MAX_SYMBOLS=40
MIN_24H_QUOTE_VOLUME=10000000
MIN_VOLUME_RATIO=1.5
MIN_ATR_PCT=0.0005
MAX_ATR_PCT=0.03
MIN_SIGNAL_SCORE=70
STOP_ATR_MULTIPLE=1.5
SIGNAL_COOLDOWN_MINUTES=60
SCAN_INTERVAL_SECONDS=300
ALLOW_SHORTS=false
SIGNAL_STATE_FILE=state.json

# Signal journal (JSONL). Leave empty to disable.
SIGNAL_JOURNAL_FILE=signals.jsonl

# Rotating log file. Leave empty for console/journald only.
LOG_FILE=
